# Copy to .env and fill in. Never commit .env.

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# ClinVar knowledge graph
KB_SCOPE=sf                                 # sf (ACMG SF v3.3 minus TTN, default) | core (22 genes, memory fallback) | dev (5 genes, tests and CI)
KB_AUTOLOAD=true                            # load kb from data/clinvar/ at startup when kb is empty
KB_BATCH_SIZE=2000

# NCBI (E-utilities for live lookups; FTP archives for the Watcher)
NCBI_EMAIL=                                 # required for live lookups (sent as the 'email' parameter); empty disables live lookups
NCBI_API_KEY=                               # optional; raises the E-utilities limit from 3 to 10 requests per second
NCBI_TOOL=recontact
LIVE_LOOKUPS=true
NCBI_CACHE_HOURS=24                         # raw HTTP responses only, never graph answers

# Optional LLM via OpenRouter for rephrasing drafts and the ask-the-org router (templates are used when empty)
OPENROUTER_API_KEY=
LLM_MODEL=                                  # required if OPENROUTER_API_KEY is set: an exact id from https://openrouter.ai/api/v1/models
LLM_DAILY_BUDGET_CALLS=300

# Security
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:3001,https://your-app.vercel.app

# Jobs and limits
WATCH_CRON=0 6 * * *                        # Watcher: daily at 06:00 UTC
HANDOFF_SWEEP_SECONDS=30
SANDBOX_TTL_MINUTES=120
SANDBOX_MAX=50

# Public URL of the web app (used in MCP text results)
WEB_BASE_URL=http://localhost:3001

# Web app (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
